<Window x:Class="ShipmentManagement.ShipmentManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShipmentManagement"
        mc:Ignorable="d"
        Title="ShipmentManagement" Height="450" Width="800">
    <Grid>

        <Label Content="Shipment Type:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,50,0,0"/>
        <ComboBox Name="ShipmentTypeComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,50,0,0" Width="200">
            <ComboBoxItem Content="Import"/>
            <ComboBoxItem Content="Export"/>
        </ComboBox>

        <Label Content="Origin:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,92,0,0"/>


        <TextBox Name="txtOrigin" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,159,0,0" Width="200"/>

        <Label Content="Destination:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,150,0,0" RenderTransformOrigin="1.055,0.782" Width="89" Height="43">
            
        </Label>


        <TextBox Name="txtDestination" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,230,0,0" Width="200"/>


        <Label Content="Shipment Date:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,217,0,0"/>

        <TextBox Name="txtDate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,92,0,0" Width="200"/>

        <Label Content="Status:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,281,0,0" RenderTransformOrigin="-3.668,6.305"/>
        <ComboBox Name="StatusComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,281,0,0" Width="200">
            <ComboBoxItem Content="Pending"/>
            <ComboBoxItem Content="In Transit"/>
            <ComboBoxItem Content="Delivered"/>
        </ComboBox>
        <!-- Button Control -->
        <Button Content="Submit" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="154,355,0,0" Width="100" Click="Button_Click" />
    </Grid>
</Window>
