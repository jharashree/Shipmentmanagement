<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<connectionStrings>
			<add name="(localdb)\mssqllocaldb" providerName="System.Data.SqlClient"
				  connectionString="Data Source=localhost;Initial Catalog=ShipmentManagement; Integrated Security=true" />

			<add name="YourDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=YourDatabase;Integrated Security=True;" providerName="System.Data.SqlClient" />
		</connectionStrings>
	</appSettings>
	
	
</configuration>